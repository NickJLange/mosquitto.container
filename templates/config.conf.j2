persistence true
persistence_location /mosquitto/data/
log_dest file /mosquitto/log/mosquitto.log
listener 1883 {{ mqtt_bind_address }}
allow_anonymous true
{% if mqtt_tls_enabled | bool %}

listener {{ mqtt_tls_port }} {{ mqtt_bind_address }}
certfile /ssl/{{ mqtt_tls_certfile | relpath('/etc/letsencrypt') }}
keyfile /ssl/{{ mqtt_tls_keyfile | relpath('/etc/letsencrypt') }}
{% endif %}
